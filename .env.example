# PRISM — Environment Configuration Template
# Copy this file to .env to customize local settings (optional, defaults are pre-configured)

# Backend Server Port (Default: 3001)
PORT=3001

# Node Environment ('development' | 'production')
NODE_ENV=development

# Authoritative SQLite Database Path (Default: server/db/prism_warehouse.db)
PRISM_DB_PATH=server/db/prism_warehouse.db

# Frontend Dev Server Proxy Target
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
