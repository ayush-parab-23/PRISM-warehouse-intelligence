{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --experimental-sqlite --import tsx server/index.ts",
    "test": "node --experimental-sqlite --import tsx tests/verify_prism.ts",
    "test:api": "node --experimental-sqlite --import tsx tests/api_e2e_test.ts",
    "test:all": "node --experimental-sqlite --import tsx tests/verify_prism.ts && node --experimental-sqlite --import tsx tests/api_e2e_test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.5.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
